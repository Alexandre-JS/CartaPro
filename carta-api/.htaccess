# Esta pasta guarda a aplicação: o .env com a chave que cobra
# clientes, o código e as dependências. Nada aqui pode ser servido.
<IfModule mod_authz_core.c>
    Require all denied
</IfModule>
<IfModule !mod_authz_core.c>
    Order allow,deny
    Deny from all
</IfModule>
<IfModule mod_php.c>
    php_flag engine off
</IfModule>
