# Ambiente dos testes. O Laravel prefere este ficheiro quando APP_ENV=testing,
# o que resolve dois problemas de uma vez: em CI não existe .env nenhum, e na
# máquina de quem desenvolve os testes liam as credenciais reais do .env — um
# teste chegou a passar só porque o wallet_code de produção calhava ser o
# mesmo do teste, e partiu-se assim que a carteira verdadeira foi configurada.
#
# Não tem segredos: a chave abaixo é descartável e a base de dados é o SQLite
# em memória imposto pelo phpunit.xml. Por isso vai para o git.

APP_NAME=CartaPro
APP_ENV=testing
APP_KEY=base64:s4yhpO+GXuoY9pzl2Qojwf4DcQqtpHR7akfRAkH6S30=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=pt
APP_FALLBACK_LOCALE=pt
APP_FAKER_LOCALE=pt_PT

LOG_CHANNEL=stack
LOG_LEVEL=debug

DB_CONNECTION=sqlite
DB_DATABASE=:memory:

SESSION_DRIVER=array
CACHE_STORE=array
QUEUE_CONNECTION=sync
MAIL_MAILER=array

# 'fake' é o predefinido de quem não configurou nada — é este o caminho que os
# testes de fluxo exercitam. Os testes que precisam de um fornecedor a sério
# forçam 'real' e as credenciais no seu próprio setUp.
PAYMENTS_ENABLED=true
PAYMENTS_PROVIDER=fake
PAYMENTS_CURRENCY=MZN
PAYMENTS_PRICE=129
PAYMENTS_DAYS=90

# Vazias de propósito: nenhum teste pode depender de credenciais do ambiente.
DEBITOPAY_API_KEY=
DEBITOPAY_MERCHANT_ID=
DEBITOPAY_WALLET_CODE=
DEBITOPAY_MPESA_WALLET_CODE=
DEBITOPAY_EMOLA_WALLET_CODE=
DEBITOPAY_WEBHOOK_SECRET=

MPESA_API_KEY=
MPESA_PUBLIC_KEY=
PAYSUITE_TOKEN=
PAYSUITE_WEBHOOK_SECRET=
SMS_ENDPOINT=
