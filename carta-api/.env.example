APP_NAME="CartaPro API"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://api.cartapro.co.mz

# Website ProntoVia — valores vazios não geram links públicos.
PRONTOVIA_ANDROID_URL=
PRONTOVIA_WEB_APP_URL=
PRONTOVIA_SCHOOL_URL=
PRONTOVIA_SUPPORT_EMAIL=
PRONTOVIA_CONTACT_PHONE=
PRONTOVIA_CONTACT_PHONE_URL=
PRONTOVIA_BUSINESS_HOURS=
PRONTOVIA_SOCIAL_IMAGE=
PRONTOVIA_HOME_HERO_IMAGE=
PRONTOVIA_CANDIDATE_HERO_IMAGE=
PRONTOVIA_SCHOOL_HERO_IMAGE=
PRONTOVIA_SCHOOLS_SECTION_IMAGE=
PRONTOVIA_FACEBOOK_URL=
PRONTOVIA_INSTAGRAM_URL=
PRONTOVIA_LINKEDIN_URL=

APP_TIMEZONE=Africa/Maputo

APP_LOCALE=pt
APP_FALLBACK_LOCALE=pt
APP_FAKER_LOCALE=pt_PT

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=cartaPro
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Gateway de SMS para o OTP de desbloqueio (vazio = código apenas no log)
SMS_ENDPOINT=
SMS_TOKEN=
SMS_SENDER=CartaPro

# Pagamento
# 'fake' aprova sem cobrar e só é aceite em local/testing — em produção o
# arranque falha se ficar por definir, para o plano completo não passar a
# gratuito por descuido.
PAYMENTS_ENABLED=false
PAYMENTS_PROVIDER=fake
PAYMENTS_CURRENCY=MZN
PAYMENTS_PRICE=129
PAYMENTS_DAYS=365

# M-Pesa (Vodacom OpenAPI). Confirmar mercado, host e prefixo no portal quando
# a conta de comerciante for emitida; passar a produção é trocar o prefixo
# 'sandbox' por 'openapi'.
MPESA_HOST=openapi.m-pesa.com
MPESA_PATH_PREFIX=sandbox
MPESA_MARKET=vodacomMOZ
MPESA_COUNTRY=MOZ
MPESA_API_KEY=
MPESA_PUBLIC_KEY=
MPESA_SERVICE_PROVIDER_CODE=

# Prefixos por operadora (2 dígitos nacionais). Configuráveis porque a
# atribuição de numeração muda e um prefixo novo não pode impedir um pagamento.
MPESA_PREFIXES=84,85
EMOLA_PREFIXES=86,87
MKESH_PREFIXES=82

# Quem executa cada método. 'debitopay' cobra os quatro por um só endpoint;
# 'mpesa' (OpenAPI da Vodacom) e 'paysuite' são as alternativas directas.
MPESA_DRIVER=debitopay
EMOLA_DRIVER=debitopay
MKESH_DRIVER=debitopay
CARD_DRIVER=debitopay

# Mínimos por transação impostos pela DebitoPay. Abaixo disto o pedido é
# recusado com 400, por isso o aluno é avisado antes de tentar.
MPESA_MIN=10
EMOLA_MIN=50
MKESH_MIN=10
CARD_MIN=50

# DebitoPay. Crie a chave, o merchant e as wallets no portal. Pode usar uma
# wallet comum ou informar uma por método. Em produção use sk_live_; no
# sandbox, sk_sandbox_. Nunca coloque esta chave no aplicativo mobile.
#
# A documentação anuncia https://api.debitopay.com/v1 como URL de integração,
# mas esse host ainda não apresenta certificado TLS válido — o endereço abaixo
# é o que a própria documentação usa nos exemplos e o que responde hoje.
# Troque-o assim que o api.debitopay.com estiver no ar.
DEBITOPAY_BASE_URL=https://gyqoaningqhurhvdugne.supabase.co/functions/v1
DEBITOPAY_API_KEY=
DEBITOPAY_MERCHANT_ID=
DEBITOPAY_WALLET_CODE=
DEBITOPAY_MPESA_WALLET_CODE=
DEBITOPAY_EMOLA_WALLET_CODE=
DEBITOPAY_MKESH_WALLET_CODE=
DEBITOPAY_CARD_WALLET_CODE=
DEBITOPAY_WEBHOOK_SECRET=
DEBITOPAY_TIMEOUT=30
# Para onde o Hosted Checkout devolve o cliente depois de pagar com cartão.
# Vazio usa APP_URL/pagamento/resultado.
DEBITOPAY_RETURN_URL=

# e-Mola via agregador: a Movitel não publica API (SOAP, só por acordo
# comercial). O webhook é recusado sem segredo definido.
PAYSUITE_BASE_URL=https://paysuite.tech/api/v1
PAYSUITE_TOKEN=
PAYSUITE_WEBHOOK_SECRET=

# A promessa mostrada no ecrã de desbloqueio. Uma frase. Editável sem deploy.
PAYMENTS_PROMISE="Chega ao INATRO sem dúvidas."
# Vazio = não se mostra garantia nenhuma. Preencher só com um compromisso que a
# CartaPro assuma mesmo (ex.: devolução em 7 dias).
PAYMENTS_GUARANTEE=
